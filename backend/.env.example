# Copie para backend/.env no desenvolvimento local. Na hospedagem, configure como variáveis de ambiente.

# Modo de desenvolvimento: mensagens de erro detalhadas. Nunca use True em produção.
DJANGO_DEBUG=True

# Obrigatória em produção. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# Domínios que podem acessar o backend, separados por vírgula (no Render o endereço .onrender.com entra sozinho).
# DJANGO_ALLOWED_HOSTS=seu-dominio.com.br,www.seu-dominio.com.br

# Banco de dados. Sem esta variável, usa o SQLite local (db.sqlite3).
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Só se o frontend ficar em outro domínio (ex.: Vercel). Separados por vírgula.
# CORS_ALLOWED_ORIGINS=https://seu-app.vercel.app

# Pasta das fotos de perfil. Em produção, aponte para um disco persistente.
# DJANGO_MEDIA_ROOT=/var/data/media
